            <Image url="@../../images/normal_face.png" />
         </image>
      </ImageView>
      <ImageView fx:id="hard_image" fitHeight="275.0" fitWidth="398.0" layoutX="244.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" visible="false">
         <image>
            <Image url="@../../images/hard_face.png" />
         </image>
      </ImageView>
      <Label fx:id="difficulty_label" alignment="CENTER" contentDisplay="CENTER" layoutX="313.0" layoutY="234.0" prefHeight="72.0" prefWidth="261.0" text="Normal" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font name="Arial Black" size="54.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
