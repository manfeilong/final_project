<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="960.0" style="-fx-background-color: #708090;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="assignment.demo.HelloController">
   <children>
      <VBox alignment="CENTER" layoutX="319.0" layoutY="382.0" prefHeight="125.0" prefWidth="248.0" spacing="20.0">
          <padding>
              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
          </padding>
      
          <Label fx:id="welcomeText" />
         <Slider fx:id="choose_difficulty" blockIncrement="1.0" majorTickUnit="1.0" max="2.0" minorTickCount="0" onMouseClicked="#on_difficulty_slider_switch" onMouseDragEntered="#on_difficulty_slider_switch" onMouseDragExited="#on_difficulty_slider_switch" onMouseDragOver="#on_difficulty_slider_switch" onMouseDragReleased="#on_difficulty_slider_switch" onMouseDragged="#on_difficulty_slider_switch" onMouseExited="#on_difficulty_slider_switch" onMouseReleased="#on_difficulty_slider_switch" prefHeight="78.0" prefWidth="124.0" snapToTicks="true" stylesheets="@normal_slider.css" value="1.0" />
      </VBox>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="361.0" layoutY="313.0" prefHeight="97.0" prefWidth="165.0" text="Drag to adjust difficulty" textAlignment="CENTER" textFill="WHITE" wrapText="true">
         <font>
            <Font name="Arial Black" size="18.0" />
         </font>
      </Label>
      <ImageView fx:id="easy_play" fitHeight="150.0" fitWidth="200.0" layoutX="697.0" layoutY="410.0" onMouseClicked="#on_easy_PVE_click" pickOnBounds="true" preserveRatio="true" visible="false">
         <image>
            <Image url="@../../images/easy.png" />
         </image>
      </ImageView>
      <ImageView fx:id="normal_play" fitHeight="150.0" fitWidth="200.0" layoutX="697.0" layoutY="409.0" onMouseClicked="#on_normal_PVE_click" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../images/normal.png" />
         </image>
      </ImageView>
      <ImageView fx:id="hard_play" fitHeight="150.0" fitWidth="200.0" layoutX="697.0" layoutY="406.0" onMouseClicked="#on_hard_PVE_click" pickOnBounds="true" preserveRatio="true" visible="false">
         <image>
            <Image url="@../../images/hard.png" />
         </image>
      </ImageView>
      <ImageView fx:id="easy_image" fitHeight="275.0" fitWidth="398.0" layoutX="244.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../images/easy_face.png" />
         </image>
      </ImageView>
      <ImageView fx:id="normal_image" fitHeight="275.0" fitWidth="398.0" layoutX="244.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
